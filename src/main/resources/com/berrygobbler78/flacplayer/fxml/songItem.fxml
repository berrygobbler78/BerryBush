<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="border" stylesheets="@../css/song-item.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berrygobbler78.flacplayer.controllers.SongItemController">
   <center>
      <HBox alignment="CENTER_LEFT" BorderPane.alignment="CENTER" HBox.hgrow="ALWAYS">
         <children>
            <StackPane>
               <children>
                  <ImageView fx:id="albumImageView" fitHeight="150.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" styleClass="album-art">
                     <image>
                        <Image url="@../graphics/default_album_image.jpg" />
                     </image>
                  </ImageView>
                  <ImageView fx:id="playButtonImageView" fitHeight="20.0" fitWidth="20.0" opacity="0.0" pickOnBounds="true" preserveRatio="true" styleClass="play-button">
                     <image>
                        <Image url="@../graphics/playback/play.png" />
                     </image>
                  </ImageView>
               </children>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </StackPane>
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="titleLabel" maxWidth="1.7976931348623157E308" prefHeight="19.0" styleClass="header" stylesheets="@../css/root.css" text="Song">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>
                  <Label fx:id="artistLabel" maxWidth="1.7976931348623157E308" styleClass="text" stylesheets="@../css/root.css" text="Artist">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
